{
  "name": "corex-code",
  "version": "0.1.0",
  "description": "A local-first AI coding agent with safe, reviewable edits.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.5",
  "bin": {
    "corex": "./dist/corex.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outfile=dist/corex.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "check": "bun run typecheck && bun run lint && bun test && bun run build"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "diff": "^8.0.2",
    "ollama": "^0.6.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "oxlint": "^1.27.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
